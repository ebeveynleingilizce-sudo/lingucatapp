{
  "functions": [
    {
      "source": "functions",
      "codebase": "lingucat",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "storage": {
      "port": 9199
    }
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "linguadmin-818758464845",
    "public": ".firebase/linguadmin-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/apps/linguadmin/",
        "type": 302
      },
      {
        "source": "/assets/:name.mp4",
        "destination": "https://ebeveynleingilizce-sudo.github.io/lingucatapp/assets/:name.mp4",
        "type": 302
      },
      {
        "type": 302,
        "destination": "https://ebeveynleingilizce-sudo.github.io/lingucatapp/games/battle-arena/:path",
        "source": "/games/battle-arena/:path*"
      },
      {
        "type": 302,
        "destination": "https://ebeveynleingilizce-sudo.github.io/lingucatapp/games/mystery-box/:path",
        "source": "/games/mystery-box/:path*"
      }
    ],
    "headers": [
      {
        "source": "/apps/linguadmin/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/apps/linguadmin/app.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
