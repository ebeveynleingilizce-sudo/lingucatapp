rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function own(uid) { return request.auth != null && request.auth.uid == uid; }
    // All mutations, roles, rewards and teacher reports pass through verified callables.
    match /users/{uid} {
      allow read: if own(uid);
      allow write: if false;
      match /{document=**} { allow read: if own(uid); allow write: if false; }
    }
    match /userRoles/{uid} { allow read: if own(uid); allow write: if false; }
    match /userStats/{uid} { allow read: if own(uid); allow write: if false; }
    match /progress/{uid}/{document=**} { allow read: if own(uid); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
